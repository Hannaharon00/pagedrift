msgstr "Резервное копирование уже запущено. Повторите попытку через несколько минут."

#: changedetectionio/blueprint/backups/__init__.py
msgid "Maximum number of backups reached, please remove some"
msgstr "Достигнуто максимальное количество резервных копий. Удалите некоторые из них."

#: changedetectionio/blueprint/backups/__init__.py
msgid "Backup building in background, check back in a few minutes."
msgstr "Резервная копия создаётся в фоновом режиме, повторите попытку через несколько минут."

#: changedetectionio/blueprint/backups/__init__.py
