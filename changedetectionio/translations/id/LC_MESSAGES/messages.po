#: changedetectionio/blueprint/add_watch_ui/__init__.py
msgid "Adding a watch with a browser needs an interactive browser (screenshots + element data) - none is configured."
msgstr ""
"Menambahkan monitor dengan browser memerlukan browser interaktif (tangkapan layar + data elemen) - belum ada yang "
"dikonfigurasi."

#: changedetectionio/blueprint/add_watch_ui/browser_config.py
#, python-format
msgid "System settings default (%(browser)s)"
msgstr "Default pengaturan sistem (%(browser)s)"

#: changedetectionio/blueprint/add_watch_ui/browser_config.py
#, python-format
msgid "System settings default (%(browser)s - no live preview)"
msgstr "Default pengaturan sistem (%(browser)s - tanpa pratinjau langsung)"

#: changedetectionio/blueprint/add_watch_ui/templates/add-watch-ui.html
msgid "Add a new web page change detection watch"
msgstr "Tambahkan monitor perubahan halaman web baru"

#: changedetectionio/blueprint/add_watch_ui/templates/add-watch-ui.html
#: changedetectionio/blueprint/ui/templates/preview.html
msgid "Go"
msgstr "Mulai"

#: changedetectionio/blueprint/add_watch_ui/templates/add-watch-ui.html
msgid "Enter a URL to get started!"
msgstr "Masukkan URL untuk memulai!"

