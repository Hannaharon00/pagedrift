msgstr "Ochrona hasłem aplikacji changedetection.io."

#: changedetectionio/blueprint/settings/templates/settings.html
msgid "Password is locked."
msgstr "Hasło jest zablokowane."

#: changedetectionio/blueprint/settings/templates/settings.html
